{
  "imports": {
    "dcmjs": "npm:dcmjs@0.39.0",
    "postgres": "npm:postgres@3.4.5",
    "drizzle-orm": "npm:drizzle-orm@0.38.3",
    "drizzle-orm/postgres-js": "npm:drizzle-orm@0.38.3/postgres-js",
    "drizzle-orm/postgres-js/migrator": "npm:drizzle-orm@0.38.3/postgres-js/migrator",
    "drizzle-orm/pg-core": "npm:drizzle-orm@0.38.3/pg-core",
    "drizzle-kit": "npm:drizzle-kit@0.24.2"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "include": ["backend/", "scripts/", "drizzle.config.ts"],
    "exclude": ["frontend/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env backend/main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "db:generate": "deno run -A npm:drizzle-kit@0.24.2 generate",
    "db:push": "deno run -A npm:drizzle-kit@0.24.2 push",
    "db:migrate": "deno run -A backend/db/migrate.ts"
  }
}
